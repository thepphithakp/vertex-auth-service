DATABASE_URL=host=localhost user=vertex password=vertex dbname=vertex_auth port=5433 sslmode=disable

# --- JWT ---
# 🔴 keys/private.pem เคยถูก commit เข้า git จึงต้องถือว่ารั่วแล้ว
#    ให้ rotate key ใหม่แล้วส่งผ่าน env สองตัวนี้จาก Secret
#    ถ้าเว้นว่าง จะ fallback ไปอ่านไฟล์ใน image (พฤติกรรมเดิม)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ⚠️ ใส่ได้เลย auth-service จะเริ่มออก claim สองตัวนี้ใน token
#    แต่ห้ามเปิดการ "ตรวจ" ที่ pet-service จนกว่าจะผ่านไปอย่างน้อย 72 ชั่วโมง
#    (เท่าอายุ token เดิม) ไม่งั้น token ที่ผู้ใช้ถืออยู่จะใช้ไม่ได้ทันที
JWT_ISSUER=
JWT_AUDIENCE=
